{
  "name": "codeforge",
  "description": "High-performance code analysis CLI tool for modern development workflows",
  "version": "0.1.0",
  "author": "CodeForge Team <team@codeforge.dev>",
  "bin": {
    "codeforge": "./bin/run.js"
  },
  "bugs": "https://github.com/codeforge-dev/codeforge/issues",
  "dependencies": {
    "@oclif/core": "^4.11.14",
    "@oclif/plugin-help": "^6.2.50",
    "@oclif/plugin-plugins": "^5.4.72",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "fast-glob": "^3.3.3",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "picomatch": "^4.0.4",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.1.18",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-oclif": "^6.0.167",
    "eslint-config-prettier": "^10.1.8",
    "oclif": "^4.23.10",
    "prettier": "^3.8.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/codeforge-dev/codeforge",
  "keywords": [
    "oclif",
    "cli",
    "code-analysis",
    "static-analysis",
    "developer-tools"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "codeforge",
    "dirname": "codeforge",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " "
  },
  "repository": "codeforge-dev/codeforge",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:strict": "eslint src/ --max-warnings=0",
    "check-all": "npm run typecheck && npm run lint && npm test",
    "verify-registries": "npm run build && node scripts/verify-registry-sync.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "oclif readme && git add README.md",
    "clean": "node bin/run.js clean",
    "clean:cache": "node bin/run.js clean --cache",
    "clean:dist": "node bin/run.js clean --dist"
  },
  "types": "dist/index.d.ts"
}
