{
  "files": ["src/**/*.ts"],
  "ignore": ["node_modules", "dist", "coverage", "**/*.test.ts", "**/*.spec.ts"],
  "rules": {
    "no-explicit-any": "error",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "no-circular-deps": "warning",
    "max-params": ["warning", { "max": 4 }],
    "max-depth": ["warning", { "max": 4 }],
    "no-console": "warning"
  }
}
