{
  "files": ["src/**/*.ts"],
  "ignore": ["node_modules/**", "dist/**", "test/**", "*.spec.ts", "**/*.e2e-spec.ts"],
  "rules": {
    "no-console": ["warning", { "allow": ["warn", "error", "log", "debug"] }],
    "prefer-const": "error",
    "no-unused-vars": "error",
    "no-any": "warning",
    "no-eval": "error",
    "max-params": ["warning", { "max": 4 }],
    "max-file-size": ["warning", { "maxBytes": 5242880 }],
    "no-circular-deps": "warning"
  }
}
