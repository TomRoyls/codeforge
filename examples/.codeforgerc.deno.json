{
  "files": ["src/**/*.ts", "src/**/*.js"],
  "ignore": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.spec.ts",
    "**/*.spec.js",
    "**/test/**",
    "**/__tests__/**"
  ],
  "rules": {
    "no-explicit-any": "warning",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "no-circular-deps": "warning",
    "max-params": ["warning", { "max": 3 }],
    "max-depth": ["warning", { "max": 3 }],
    "no-console": "warning",
    "prefer-readonly": "warning",
    "prefer-template": "warning",
    "no-eval": "error"
  }
}
