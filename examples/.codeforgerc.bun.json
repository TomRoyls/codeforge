{
  "name": "bun",
  "description": "Recommended configuration for Bun runtime projects",
  "version": "1.0.0",
  "files": ["src/**/*.ts", "src/**/*.js", "src/**/*.tsx", "src/**/*.jsx"],
  "ignore": [
    "node_modules",
    "dist",
    "coverage",
    ".bun",
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.spec.ts",
    "**/*.spec.js",
    "**/test/**",
    "**/__tests__/**"
  ],
  "rules": {
    "no-explicit-any": "warning",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "no-circular-deps": "warning",
    "max-params": ["warning", { "max": 4 }],
    "max-depth": ["warning", { "max": 4 }],
    "no-console": ["warning", { "allow": ["warn", "error"] }],
    "prefer-readonly": "warning",
    "prefer-template": "warning",
    "no-eval": "error",
    "no-dynamic-delete": "warning",
    "no-useless-comparison": "warning",
    "no-floating-promises": "error"
  },
  "output": {
    "format": "console",
    "color": true
  },
  "cache": {
    "enabled": true,
    "location": ".codeforge-cache"
  },
  "performance": {
    "concurrency": 4,
    "timeout": 30000
  },
  "thresholds": {
    "maxFiles": 500,
    "maxFileSize": 1048576,
    "maxFileLines": 500,
    "maxFunctionLines": 100
  }
}
