{
  "files": ["src/**/*.ts", "src/**/*.js"],
  "ignore": ["node_modules", "dist", "build", "coverage", ".fastify"],
  "rules": {
    "max-lines": ["warning", { "max": 200 }],
    "max-params": ["warning", { "max": 5 }],
    "max-depth": ["warning", { "max": 4 }],
    "max-complexity": ["warning", { "max": 15 }],
    "no-circular-deps": "error",
    "no-console": ["info", { "allow": ["warn", "error", "info"] }],
    "no-floating-promises": "error",
    "no-any": "warning",
    "prefer-const": "warning",
    "no-delete": "warning"
  }
}
