{
  "$schema": "https://raw.githubusercontent.com/codeforge-dev/codeforge/schema.json",
  "name": "CLI Tool",
  "description": "Configuration for CLI tools and utilities",
  "version": "1.0.0",
  "files": ["src/**/*.ts", "bin/**/*.ts", "scripts/**/*.ts", "cli/**/*.ts"],
  "ignore": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/fixtures/**",
    "**/mocks/**"
  ],
  "rules": {
    "no-any": "info",
    "no-unused-vars": "warning",
    "prefer-const": "warning",
    "no-console": "info",
    "max-params": ["error", { "max": 3 }],
    "max-depth": ["warning", { "max": 3 }],
    "no-eval": "error",
    "no-debugger": "error",
    "prefer-template": "warning"
  },
  "output": {
    "format": "console",
    "colors": true,
    "progress": true,
    "verbose": false
  },
  "timeout": 60000
}
