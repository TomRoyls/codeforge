{
  "files": ["src/**/*.ts", "src/**/*.js"],
  "ignore": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.spec.ts",
    "**/*.spec.js"
    "**/*.e2e.ts"
    "**/__generated__/**"
  ],
  "rules": {
    "no-any": "warning",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "no-circular-deps": "warning",
    "max-params": ["warning", { "max": 4 }],
    "max-depth": ["warning", { "max": 3 }],
    "no-console": ["warning", { "allow": ["warn", "error"] }],
    "prefer-readonly": "warning",
    "no-useless-comparison": "error",
    "no-delete": "warning",
    "prefer-template": "warning"
  }
}
